<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список завдань</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet"> <!--[cite: 8] -->
    <link rel="stylesheet" href="~/css/normalize.css">
    <link rel="stylesheet" href="~/css/style.css">
    <script src="~/JS/script.js" defer></script>
</head>
<body>
    <section class="section">
        <div class="container">
            <div class="request">
                <h1 class="request__heading">Список завдань</h1>
                <div class="request__card">
                    <span class="request__name">Назва завдання</span>
                    <input class="request__input-name" type="text" required>
                </div>
                <div class="request__card">
                    <span class="request__description">Опис завдання</span>
                    <textarea class="request__input-description" rows="3" required></textarea>
                </div>
                <button class="request__button">Створити завдання</button>
            </div>
            <ul class="tasks"></ul>
        </div>
    </section>
</body>
</html>